{
  "$schema": "https://spiceframework.dev/schemas/spice-docs.schema.json",
  "schema": 1,
  "product": {
    "id": "commerce",
    "title": "Commerce",
    "family": "example",
    "summary": "A reference commerce application demonstrating modular Spice composition and production integration boundaries.",
    "maturity": "preview",
    "audience": [
      "application-developer",
      "evaluator"
    ]
  },
  "content": [
    {
      "source": "README.md",
      "route": "index",
      "kind": "example",
      "order": 0,
      "search": true
    },
    {
      "source": "docs/**/*.md",
      "routeFrom": "docs",
      "order": 10,
      "search": true
    }
  ],
  "snippets": [
    {
      "root": ".",
      "include": [
        "**/*.go"
      ],
      "exclude": [
        "vendor/**",
        "internal/spicegen/**",
        ".generated/**"
      ]
    }
  ]
}
